#!/bin/sh
# Make pactl reach the user PipeWire when run from the udev/systemd batch.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Repaint wallpaper for the new screen geometry.
WALLPAPER=~/Documents/Pictures/pexels-evie-shaffer-1259279-4060937.jpg
feh --bg-fill "$WALLPAPER"

# Rebuild the lock-screen cache for the new geometry. betterlockscreen caches
# per-resolution, so a stale cache from the old layout gets stretched/cut off.
# Backgrounded: the imagemagick render takes a few seconds.
betterlockscreen -u "$WALLPAPER" >/dev/null 2>&1 &

# Route audio by dock state: HDMI (monitor speakers) when docked, analog
# (headphone jack) when undocked. Laptop speakers are dead, so never analog-out
# alone while docked.
CARD=alsa_card.pci-0000_00_1f.3
case "$AUTORANDR_CURRENT_PROFILE" in
  docked) pactl set-card-profile "$CARD" output:hdmi-stereo+input:analog-stereo ;;
  mobile) pactl set-card-profile "$CARD" output:analog-stereo+input:analog-stereo ;;
esac

# NOTE: i3 is intentionally NOT restarted here. autorandr runs at boot (same
# moment as i3-restore), and an in-place `i3-msg restart` from this hook races
# and kills the session restore mid-run — leaving only some workspaces restored.
# If a dock/undock leaves the layout on the wrong monitor ("split"), restart i3
# manually with $mod+Shift+r to re-query xrandr.
