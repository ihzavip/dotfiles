#!/usr/bin/env bash
# Cycle audio output: headphone jack -> monitor (HDMI) -> Bluetooth -> ...
# Laptop speakers are dead, so analog == headphones in practice.
# The HDMI sink only exists while the card sits in the hdmi profile, so reaching
# it means switching the card profile, not just the default sink.
# Bluetooth is skipped from the cycle whenever no bluez sink is present.
# Bound to $mod+Shift+a in i3.
set -u

CARD=alsa_card.pci-0000_00_1f.3
ANALOG=alsa_output.pci-0000_00_1f.3.analog-stereo
HDMI=alsa_output.pci-0000_00_1f.3.hdmi-stereo

sink_names() { pactl list sinks short | awk '{print $2}'; }
bt_sink() { sink_names | grep -m1 '^bluez_output\.'; }

sink_desc() {
    pactl list sinks | grep -A6 "Name: $1\$" | grep -m1 'Description:' |
        sed 's/^[[:space:]]*Description:[[:space:]]*//'
}

# A profile switch takes a moment to publish the new sink.
wait_for_sink() {
    for _ in $(seq 20); do
        sink_names | grep -qx "$1" && return 0
        sleep 0.1
    done
    return 1
}

activate() {
    wait_for_sink "$1" || return 1
    pactl set-default-sink "$1" || return 1
    # Drag already-playing streams across, or they keep feeding the old sink.
    for id in $(pactl list sink-inputs short | awk '{print $1}'); do
        pactl move-sink-input "$id" "$1" 2>/dev/null
    done
}

BT=$(bt_sink || true)

case "$(pactl get-default-sink)" in
    *hdmi*) next=bt ;;
    bluez_output*) next=analog ;;
    *) next=hdmi ;;
esac
[ "$next" = bt ] && [ -z "$BT" ] && next=analog

out=""
case "$next" in
    analog)
        pactl set-card-profile "$CARD" output:analog-stereo+input:analog-stereo
        activate "$ANALOG" && out="Headphones (jack)"
        ;;
    hdmi)
        pactl set-card-profile "$CARD" output:hdmi-stereo+input:analog-stereo
        activate "$HDMI" && out="Monitor (HDMI)"
        ;;
    bt)
        activate "$BT" && out="$(sink_desc "$BT") (Bluetooth)"
        ;;
esac

command -v notify-send >/dev/null 2>&1 &&
    notify-send -t 1500 "Audio output" "${out:-Switch to $next failed}"
