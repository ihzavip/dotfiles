[global]
    # Show notifications on the monitor with keyboard focus (follows the
    # focused window across monitors). monitor= is the fallback when follow=none.
    follow = keyboard
    monitor = 0
    origin = top-right
    offset = 10x40
    width = 320
    height = 100
    gap_size = 6
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    separator_height = 2
    separator_color = "#3c3836"
    font = JetBrainsMono Nerd Font 9
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    corner_radius = 4
    timeout = 5
    icon_position = left
    min_icon_size = 24
    max_icon_size = 32

[urgency_low]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#3c3836"
    timeout = 4

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#83a598"
    timeout = 5

[urgency_critical]
    background = "#282828"
    foreground = "#fb4934"
    frame_color = "#fb4934"
    timeout = 0
